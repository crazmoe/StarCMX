# Rufnummern-Links (tel:, callto:, sip:) für alle Benutzer mit StarCMX öffnen.
# Ablage: /etc/xdg/mimeapps.list (GNOME und KDE). KDE liest vorher
# /etc/xdg/kde-mimeapps.list; steht dort schon ein anderes Programm, die
# Zeilen auch dort eintragen. Eigene Wahl der Benutzer geht weiterhin vor.
# Flatpak: ch.crazmoe.StarCMX.desktop statt starcmx.desktop
[Default Applications]
x-scheme-handler/tel=starcmx.desktop
x-scheme-handler/callto=starcmx.desktop
x-scheme-handler/sip=starcmx.desktop
